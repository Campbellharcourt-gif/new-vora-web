# VORA — Railway PRODUCTION variables (template). Plain values are the real ones where they are
# known; an empty plain value (Turnstile site key, R2 account) is filled in when that resource is
# created (with your approval). SEALED values are always empty here: they are entered only in
# Railway's variable editor as sealed variables — never typed into a shell, never committed.
# docs/railway/variables.md explains each one.
# tests/tooling/railway-config.test.ts keeps this file honest.

# --- plain ---
APP_ENV=production
APP_ORIGIN=https://vorawebsites.store
APP_NAME=VORA
EMAIL_TRANSPORT=resend
EMAIL_FROM=VORA <hello@vorawebsites.store>
EMAIL_REPLY_TO=hello@vorawebsites.store
TEAM_NOTIFY_EMAIL=projects@vorawebsites.store
CAREERS_NOTIFY_EMAIL=careers@vorawebsites.store
TURNSTILE_SITE_KEY=
AI_GATEWAY_BASE_URL=
MAINTENANCE_MODE=off
LOG_LEVEL=info
DATABASE_PATH=/data/vora.db
R2_ACCOUNT_ID=
R2_BUCKET_MEDIA=vora-media
R2_BUCKET_PRIVATE=vora-private
R2_BUCKET_BACKUPS=vora-backups
# Cloudflare Access is required on staging only (D22); leave both unset in production.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
UV_THREADPOOL_SIZE=8
NODE_ENV=production
TZ=UTC

# --- sealed (values entered in Railway only) ---
AUTH_SECRET=
AUTH_SECRET_PREVIOUS=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
GEMINI_API_KEY=
SETUP_TOKEN=
ORIGIN_AUTH_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
