{
  "name": "vora-web",
  "private": true,
  "type": "module",
  "description": "VORA Websites — production web platform (public site, admin, client and member portals, VORA AI): one Node.js service on Railway behind Cloudflare.",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "react-router build",
    "start": "node --enable-source-maps build/server/index.js",
    "preview": "npm run build && tsx scripts/preview.ts",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "security:scan": "tsx scripts/security-scan.ts --bundle build/client --secrets-from .dev.vars --secrets-from build/server/.dev.vars",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "E2E_BROWSERS=all playwright test --project=webkit --project=mobile-webkit && E2E_BROWSERS=all playwright test --project=firefox",
    "test:e2e:https": "playwright test --config playwright.https.config.ts",
    "test:e2e:https:browsers": "E2E_BROWSERS=all playwright test --config playwright.https.config.ts --project=https-webkit --project=https-firefox",
    "e2e:prepare": "tsx scripts/e2e-prepare.ts",
    "e2e:server": "npm run e2e:prepare && react-router build && node scripts/e2e-secrets.mjs && tsx scripts/e2e-servers.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "tsx scripts/db-local.ts migrate",
    "db:integrity:local": "tsx scripts/db-local.ts integrity",
    "db:seed:local": "tsx scripts/seed.ts",
    "db:restore-prepare": "tsx scripts/restore-prepare.ts",
    "db:restore-rehearsal": "tsx scripts/restore-rehearsal.ts",
    "dev:users": "tsx scripts/dev-users.ts",
    "backup:export": "tsx scripts/backup-export.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "docker:build": "docker build -t vora-web:local .",
    "deploy:check": "npm run build && npm run security:scan && tsx scripts/deploy-check.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@libsql/client": "0.18.0",
    "aws4fetch": "1.0.20",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@noble/hashes": "2.4.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
