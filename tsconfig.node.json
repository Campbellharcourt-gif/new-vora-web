{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "react-router.config.ts",
    "drizzle.config.ts",
    "vitest.unit.config.ts",
    "vitest.integration.config.ts",
    "playwright.config.ts",
    "playwright.https.config.ts",
    "scripts/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/e2e-https/**/*.ts",
    "tests/tooling/**/*.ts",
    "shared/**/*.ts",
    "app/.server/lib/**/*.ts",
    "app/.server/db/seed/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./app/*"],
      "@shared/*": ["./shared/*"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.tsbuildinfo"
  }
}
